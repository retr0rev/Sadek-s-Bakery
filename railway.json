{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install && npm run build && cd server && go build -o bakery-server ."
  },
  "deploy": {
    "startCommand": "cd server && ./bakery-server",
    "healthcheckPath": "/api/products",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
